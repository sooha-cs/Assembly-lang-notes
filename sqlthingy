import sqlite3

# --------------------------------------------------
# 1. CONNECT TO DATABASE
# --------------------------------------------------

conn = sqlite3.connect("college.db")
cursor = conn.cursor()

print("Database connected successfully!")


# --------------------------------------------------
# 2. CREATE TABLE
# --------------------------------------------------

cursor.execute(""" CREATE TABLE IF NOT EXISTS students ( id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER, department TEXT, marks REAL ) """)

conn.commit()

print("\nTable created successfully!")


# --------------------------------------------------
# 3. INSERT OPERATION
# --------------------------------------------------

students = [
    ("Rahul", 20, "Python", 85),
    ("Amit", 21, "Python", 72),
    ("Priya", 20, "Data Science", 92),
    ("Neha", 22, "Data Science", 88),
    ("Ravi", 21, "Python", 65),
    ("Anjali", 20, "Data Science", 95)
]

cursor.executemany(""" INSERT INTO students (name, age, department, marks) VALUES (?, ?, ?, ?) """, students)

conn.commit()

print("\nRecords inserted successfully!")


# --------------------------------------------------
# 4. SELECT - DISPLAY ALL RECORDS
# --------------------------------------------------

print("\n--- ALL STUDENTS ---")

cursor.execute("SELECT * FROM students")

rows = cursor.fetchall()

for row in rows:
    print(row)


# --------------------------------------------------
# 5. SELECT SPECIFIC COLUMNS
# --------------------------------------------------

print("\n--- NAME AND MARKS ---")

cursor.execute(""" SELECT name, marks FROM students """)

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 6. WHERE CLAUSE
# --------------------------------------------------

print("\n--- STUDENTS WITH MARKS > 80 ---")

cursor.execute(""" SELECT * FROM students WHERE marks > ? """, (80,))

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 7. AND OPERATOR
# --------------------------------------------------

print("\n--- AGE 20 AND MARKS > 80 ---")

cursor.execute(""" SELECT * FROM students WHERE age = ? AND marks > ? """, (20, 80))

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 8. OR OPERATOR
# --------------------------------------------------

print("\n--- AGE 20 OR MARKS > 90 ---")

cursor.execute(""" SELECT * FROM students WHERE age = ? OR marks > ? """, (20, 90))

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 9. LIKE OPERATOR
# --------------------------------------------------

print("\n--- NAMES STARTING WITH 'A' ---")

cursor.execute(""" SELECT * FROM students WHERE name LIKE ? """, ("A%",))

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 10. ORDER BY ASCENDING
# --------------------------------------------------

print("\n--- MARKS LOW TO HIGH ---")

cursor.execute(""" SELECT * FROM students ORDER BY marks ASC """)

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 11. ORDER BY DESCENDING
# --------------------------------------------------

print("\n--- MARKS HIGH TO LOW ---")

cursor.execute(""" SELECT * FROM students ORDER BY marks DESC """)

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 12. LIMIT
# --------------------------------------------------

print("\n--- TOP 3 STUDENTS ---")

cursor.execute(""" SELECT * FROM students ORDER BY marks DESC LIMIT 3 """)

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 13. COUNT()
# --------------------------------------------------

print("\n--- TOTAL NUMBER OF STUDENTS ---")

cursor.execute(""" SELECT COUNT(*) FROM students """)

count = cursor.fetchone()[0]

print("Total Students:", count)


# --------------------------------------------------
# 14. SUM()
# --------------------------------------------------

print("\n--- TOTAL MARKS ---")

cursor.execute(""" SELECT SUM(marks) FROM students """)

total_marks = cursor.fetchone()[0]

print("Total Marks:", total_marks)


# --------------------------------------------------
# 15. AVG()
# --------------------------------------------------

print("\n--- AVERAGE MARKS ---")

cursor.execute(""" SELECT AVG(marks) FROM students """)

average = cursor.fetchone()[0]

print("Average Marks:", average)


# --------------------------------------------------
# 16. MAX()
# --------------------------------------------------

print("\n--- HIGHEST MARKS ---")

cursor.execute(""" SELECT MAX(marks) FROM students """)

maximum = cursor.fetchone()[0]

print("Highest Marks:", maximum)


# --------------------------------------------------
# 17. MIN()
# --------------------------------------------------

print("\n--- LOWEST MARKS ---")

cursor.execute(""" SELECT MIN(marks) FROM students """)

minimum = cursor.fetchone()[0]

print("Lowest Marks:", minimum)


# --------------------------------------------------
# 18. GROUP BY
# --------------------------------------------------

print("\n--- STUDENT COUNT BY DEPARTMENT ---")

cursor.execute(""" SELECT department, COUNT(*) FROM students GROUP BY department """)

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 19. UPDATE OPERATION
# --------------------------------------------------

print("\n--- UPDATE MARKS ---")

cursor.execute(""" UPDATE students SET marks = ? WHERE name = ? """, (90, "Rahul"))

conn.commit()

print("Rahul's marks updated successfully!")


# Display updated record
cursor.execute(""" SELECT * FROM students WHERE name = ? """, ("Rahul",))

print(cursor.fetchone())


# --------------------------------------------------
# 20. DELETE OPERATION
# --------------------------------------------------

print("\n--- DELETE RECORD ---")

cursor.execute(""" DELETE FROM students WHERE name = ? """, ("Ravi",))

conn.commit()

print("Ravi's record deleted successfully!")


# --------------------------------------------------
# 21. DISPLAY FINAL RECORDS
# --------------------------------------------------

print("\n--- FINAL STUDENT RECORDS ---")

cursor.execute(""" SELECT * FROM students """)

for row in cursor.fetchall():
    print(row)


# --------------------------------------------------
# 22. CLOSE DATABASE
# --------------------------------------------------

conn.close()

print("\nDatabase connection closed!")